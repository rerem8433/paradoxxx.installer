/dts-v1/;

/ {
	#address-cells = <0x1>;
	#size-cells = <0x1>;
	compatible = "rockchip,rk3229";
	interrupt-parent = <0x1>;

	chosen {
		bootargs = "vmalloc=496M psci=enable rockchip_jtag";
	};

	aliases {
		serial0 = "/serial@11010000";
		serial1 = "/serial@11020000";
		serial2 = "/serial@11030000";
		i2c0 = "/i2c@11050000";
		i2c1 = "/i2c@11060000";
		i2c2 = "/i2c@11070000";
		i2c3 = "/i2c@11080000";
		lcdc0 = "/vop@20050000";
		spi0 = "/spi@11090000";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x0>;
	};

	clocks {
		compatible = "rockchip,rk-clocks";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0x0 0x110e0000 0x1000>;

		fixed_rate_cons {
			compatible = "rockchip,rk-fixed-rate-cons";

			xin24m {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "xin24m";
				clock-frequency = <0x16e3600>;
				#clock-cells = <0x0>;
				linux,phandle = <0x2>;
				phandle = <0x2>;
			};

			xin12m {
				compatible = "rockchip,rk-fixed-clock";
				clocks = <0x2>;
				clock-output-names = "xin12m";
				clock-frequency = <0xb71b00>;
				#clock-cells = <0x0>;
				linux,phandle = <0x14>;
				phandle = <0x14>;
			};

			hdmiphy_out {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "hdmiphy_out";
				clock-frequency = <0x2367b880>;
				#clock-cells = <0x0>;
				linux,phandle = <0x45>;
				phandle = <0x45>;
			};

			usbphy0_480m {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "usbphy0_480m";
				clock-frequency = <0x1c9c3800>;
				#clock-cells = <0x0>;
				linux,phandle = <0x46>;
				phandle = <0x46>;
			};

			usbphy1_480m {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "usbphy1_480m";
				clock-frequency = <0x1c9c3800>;
				#clock-cells = <0x0>;
				linux,phandle = <0x47>;
				phandle = <0x47>;
			};

			jtag_clkin {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "jtag_clkin";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
				linux,phandle = <0x4c>;
				phandle = <0x4c>;
			};

			dummy {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "dummy";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
				linux,phandle = <0x38>;
				phandle = <0x38>;
			};

			gmac_clkin {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "gmac_clkin";
				clock-frequency = <0x7735940>;
				#clock-cells = <0x0>;
				linux,phandle = <0x3c>;
				phandle = <0x3c>;
			};

			phy_50m_out {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "phy_50m_out";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
				linux,phandle = <0x3d>;
				phandle = <0x3d>;
			};

			phy_rx_out {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "phy_rx_out";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
			};

			phy_tx_out {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "phy_tx_out";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
			};

			clkin_hsadc_tsp {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "clkin_hsadc_tsp";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
				linux,phandle = <0x53>;
				phandle = <0x53>;
			};

			i2s_clkin {
				compatible = "rockchip,rk-fixed-clock";
				clock-output-names = "i2s_clkin";
				clock-frequency = <0x0>;
				#clock-cells = <0x0>;
				linux,phandle = <0x13>;
				phandle = <0x13>;
			};
		};

		fixed_factor_cons {
			compatible = "rockchip,rk-fixed-factor-cons";

			hclk_rkvdec {
				compatible = "rockchip,rk-fixed-factor-clock";
				clocks = <0x3>;
				clock-output-names = "hclk_rkvdec";
				clock-div = <0x4>;
				clock-mult = <0x1>;
				#clock-cells = <0x0>;
				linux,phandle = <0x58>;
				phandle = <0x58>;
			};

			hclk_vpu {
				compatible = "rockchip,rk-fixed-factor-clock";
				clocks = <0x4>;
				clock-output-names = "hclk_vpu";
				clock-div = <0x4>;
				clock-mult = <0x1>;
				#clock-cells = <0x0>;
				linux,phandle = <0x96>;
				phandle = <0x96>;
			};

			xin32k_out {
				compatible = "rockchip,rk-fixed-clock";
				clocks = <0x5>;
				clock-output-names = "xin32k_out";
				clock-div = <0x1>;
				clock-mult = <0x1>;
				#clock-cells = <0x0>;
			};
		};

		clock_regs {
			compatible = "rockchip,rk-clock-regs";
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			reg = <0x0 0x1000>;
			ranges;

			pll_cons {
				compatible = "rockchip,rk-pll-cons";
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				ranges;

				pll-clk@0000 {
					compatible = "rockchip,rk3188-pll-clk";
					reg = <0x0 0x10>;
					mode-reg = <0x40 0x0>;
					status-reg = <0x4 0xa>;
					clocks = <0x2>;
					clock-output-names = "clk_apll";
					rockchip,pll-type = <0x40>;
					#clock-cells = <0x0>;
					linux,phandle = <0x7>;
					phandle = <0x7>;
				};

				pll-clk@000c {
					compatible = "rockchip,rk3188-pll-clk";
					reg = <0xc 0x10>;
					mode-reg = <0x40 0x4>;
					status-reg = <0x10 0xa>;
					clocks = <0x2>;
					clock-output-names = "clk_dpll";
					rockchip,pll-type = <0x80>;
					#clock-cells = <0x0>;
					linux,phandle = <0x9>;
					phandle = <0x9>;
				};

				pll-clk@0018 {
					compatible = "rockchip,rk3188-pll-clk";
					reg = <0x18 0x10>;
					mode-reg = <0x40 0x8>;
					status-reg = <0x1c 0xa>;
					clocks = <0x2>;
					clock-output-names = "clk_cpll";
					rockchip,pll-type = <0x100>;
					#clock-cells = <0x0>;
					#clock-init-cells = <0x1>;
					linux,phandle = <0xb>;
					phandle = <0xb>;
				};

				pll-clk@0024 {
					compatible = "rockchip,rk3188-pll-clk";
					reg = <0x24 0x10>;
					mode-reg = <0x40 0xc>;
					status-reg = <0x28 0xa>;
					clocks = <0x2>;
					clock-output-names = "clk_gpll";
					rockchip,pll-type = <0x100>;
					#clock-cells = <0x0>;
					#clock-init-cells = <0x1>;
					linux,phandle = <0x8>;
					phandle = <0x8>;
				};
			};

			clk_sel_cons {
				compatible = "rockchip,rk-sel-cons";
				#address-cells = <0x1>;
				#size-cells = <0x1>;
				ranges;

				sel-con@0044 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x44 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					clk_core_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x5>;
						clocks = <0x6>;
						clock-output-names = "clk_core";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xb>;
						rockchip,flags = <0xc0>;
					};

					clk_core_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x6 0x2>;
						clocks = <0x7 0x8 0x9>;
						clock-output-names = "clk_core";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x6>;
						phandle = <0x6>;
					};

					aclk_bus_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x8 0x5>;
						clocks = <0xa>;
						clock-output-names = "aclk_bus";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x100>;
						linux,phandle = <0xd>;
						phandle = <0xd>;
					};

					aclk_bus_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xd 0x2>;
						clocks = <0xb 0x8 0xc>;
						clock-output-names = "aclk_bus";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0xa>;
						phandle = <0xa>;
					};
				};

				sel-con@0048 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x48 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					pclk_dbg_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x4>;
						clocks = <0x6>;
						clock-output-names = "pclk_dbg";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xc>;
						linux,phandle = <0x60>;
						phandle = <0x60>;
					};

					aclk_core_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x4 0x3>;
						clocks = <0x6>;
						clock-output-names = "aclk_core";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xc>;
						linux,phandle = <0x44>;
						phandle = <0x44>;
					};

					hclk_bus_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x8 0x2>;
						clocks = <0xd>;
						clock-output-names = "hclk_bus";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x51>;
						phandle = <0x51>;
					};

					pclk_bus_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0xc 0x3>;
						clocks = <0xd>;
						clock-output-names = "pclk_bus";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x4f>;
						phandle = <0x4f>;
					};
				};

				sel-con@004c {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x4c 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					hclk_vio_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x5>;
						clocks = <0xe>;
						clock-output-names = "hclk_vio";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x57>;
						phandle = <0x57>;
					};

					clk_nandc_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x8 0x5>;
						clocks = <0xf>;
						clock-output-names = "clk_nandc";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x100>;
					};

					clk_nandc_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xe 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_nandc";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0xf>;
						phandle = <0xf>;
					};
				};

				sel-con@0050 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x50 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					clk_i2s1_pll_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x7>;
						clocks = <0x10>;
						clock-output-names = "clk_i2s1_pll";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x180>;
						linux,phandle = <0x11>;
						phandle = <0x11>;
					};

					clk_i2s1_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x8 0x2>;
						clocks = <0x11 0x12 0x13 0x14>;
						clock-output-names = "clk_i2s1";
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xe>;
						rockchip,flags = <0x4>;
						linux,phandle = <0x15>;
						phandle = <0x15>;
					};

					clk_i2s1_out_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xc 0x1>;
						clocks = <0x15 0x14>;
						clock-output-names = "clk_i2s1_out";
						#clock-cells = <0x0>;
						linux,phandle = <0x4b>;
						phandle = <0x4b>;
					};

					i2s1_pll_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xf 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_i2s1_pll";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x10>;
						phandle = <0x10>;
					};
				};

				sel-con@0054 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x54 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					testclk_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x5>;
						clocks = <0x16>;
						clock-output-names = "testclk";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
					};

					clk_24m_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x8 0x5>;
						clocks = <0x2>;
						clock-output-names = "clk_24m";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
					};
				};

				sel-con@0058 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x58 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					clk_mac_pll_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x5>;
						clocks = <0x17>;
						clock-output-names = "clk_mac_pll";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x100>;
						linux,phandle = <0x3e>;
						phandle = <0x3e>;
					};

					clk_mac_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x5 0x1>;
						clocks = <0x17 0x18>;
						clock-output-names = "clk_mac";
						#clock-cells = <0x0>;
						rockchip,flags = <0x4>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x4e>;
						phandle = <0x4e>;
					};

					clk_mac_pll_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x7 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_mac_pll";
						#clock-cells = <0x0>;
						linux,phandle = <0x17>;
						phandle = <0x17>;
					};

					clk_gmac_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x8 0x5>;
						clocks = <0x19>;
						clock-output-names = "clk_gmac";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x100>;
					};

					clk_gmac_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xf 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_gmac";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x19>;
						phandle = <0x19>;
					};
				};

				sel-con@005c {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x5c 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					spdif_div {
						compatible = "rockchip,rk3188-div-con";
						rockchip,bits = <0x0 0x7>;
						clocks = <0x1a>;
						clock-output-names = "clk_spdif_pll";
						rockchip,div-type = <0x0>;
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0x1>;
						rockchip,flags = <0x180>;
						linux,phandle = <0x1b>;
						phandle = <0x1b>;
					};

					spdif_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x8 0x2>;
						clocks = <0x1b 0x1c 0x14>;
						clock-output-names = "clk_spdif";
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xe>;
						rockchip,flags = <0x4>;
						linux,phandle = <0x8c>;
						phandle = <0x8c>;
					};

					spdif_pll_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xf 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_spdif_pll";
						#clock-cells = <0x0>;
						#clock-init-cells = <0x1>;
						linux,phandle = <0x1a>;
						phandle = <0x1a>;
					};
				};

				sel-con@0060 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x60 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					i2s1_frac {
						compatible = "rockchip,rk3188-frac-con";
						clocks = <0x11>;
						clock-output-names = "i2s1_frac";
						rockchip,bits = <0x0 0x20>;
						rockchip,clkops-idx = <0x5>;
						#clock-cells = <0x0>;
						linux,phandle = <0x12>;
						phandle = <0x12>;
					};
				};

				sel-con@0064 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x64 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					i2s0_frac {
						compatible = "rockchip,rk3188-frac-con";
						clocks = <0x1d>;
						clock-output-names = "i2s0_frac";
						rockchip,bits = <0x0 0x20>;
						rockchip,clkops-idx = <0x5>;
						#clock-cells = <0x0>;
						linux,phandle = <0x1f>;
						phandle = <0x1f>;
					};
				};

				sel-con@0068 {
					compatible = "rockchip,rk3188-selcon";
					reg = <0x68 0x4>;
					#address-cells = <0x1>;
					#size-cells = <0x1>;

					clk_i2s0_pll_div {
						compatible = "rockchip,rk3188-div-con";
