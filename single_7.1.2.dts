			vactive = <0x870>;
			hback-porch = <0x128>;
			hfront-porch = <0xb0>;
			vback-porch = <0x48>;
			vfront-porch = <0x8>;
			hsync-len = <0x58>;
			vsync-len = <0xa>;
			hsync-active = <0x1>;
			vsync-active = <0x1>;
			de-active = <0x0>;
			pixelclk-active = <0x0>;
			swap-rb = <0x0>;
			swap-rg = <0x0>;
			swap-gb = <0x0>;
		};

		timing3 {
			screen-type = <0x5>;
			out-face = <0x0>;
			color-mode = <0x2>;
			clock-frequency = <0x19bfcc0>;
			hactive = <0x2d0>;
			vactive = <0x1e0>;
			hback-porch = <0x2b>;
			hfront-porch = <0x21>;
			vback-porch = <0x13>;
			vfront-porch = <0x0>;
			hsync-len = <0x3e>;
			vsync-len = <0x3>;
			hsync-active = <0x1>;
			vsync-active = <0x1>;
			de-active = <0x0>;
			pixelclk-active = <0x1>;
			swap-rb = <0x0>;
			swap-rg = <0x0>;
			swap-gb = <0x0>;
			interlaced;
		};

		timing4 {
			screen-type = <0x5>;
			out-face = <0x0>;
			color-mode = <0x2>;
			clock-frequency = <0x19bfcc0>;
			hactive = <0x2d0>;
			vactive = <0x240>;
			hback-porch = <0x30>;
			hfront-porch = <0x21>;
			vback-porch = <0x13>;
			vfront-porch = <0x2>;
			hsync-len = <0x3f>;
			vsync-len = <0x3>;
			hsync-active = <0x1>;
			vsync-active = <0x1>;
			de-active = <0x0>;
			pixelclk-active = <0x1>;
			swap-rb = <0x0>;
			swap-rg = <0x0>;
			swap-gb = <0x0>;
			interlaced;
		};
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		wifi_chip_type = "ap6330";
		sdio_vref = <0x708>;
		WIFI,poweren_gpio = <0x7d 0x1a 0x0>;
		WIFI,host_wake_irq = <0x76 0x1c 0x0>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0xb4 0x6 0x1>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0xb5>;
		pinctrl-1 = <0xb6>;
		BT,power_gpio = <0x7d 0x1d 0x0>;
		BT,wake_gpio = <0xb4 0x1b 0x0>;
		BT,wake_host_irq = <0xb4 0x1a 0x0>;
		status = "okay";
		LED,blue_gpio = <0x8e 0x7 0x1>;
		LED,red_gpio = <0xb4 0x15 0x1>;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		regulator@0 {
			compatible = "regulator-fixed";
			regulator-name = "vccio_1v8";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			regulator-always-on;
			linux,phandle = <0x5d>;
			phandle = <0x5d>;
		};

		regulator@1 {
			compatible = "regulator-fixed";
			regulator-name = "vccio_3v3";
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
			regulator-always-on;
			linux,phandle = <0x5c>;
			phandle = <0x5c>;
		};
	};

	pwm-regulator1 {
		compatible = "rockchip_pwm_regulator";
		pwms = <0xb7 0x0 0x1388>;
		rockchip,pwm_id = <0x1>;
		rockchip,pwm_voltage_map = <0xe7ef0 0xee098 0xf4240 0xfa3e8 0x100590 0x106738 0x10c8e0 0x112a88 0x118c30 0x11edd8 0x124f80 0x12b128 0x1312d0 0x137478 0x13d620 0x1437c8 0x149970 0x14fb18 0x155cc0>;
		rockchip,pwm_voltage = <0x10c8e0>;
		rockchip,pwm_min_voltage = <0xe7ef0>;
		rockchip,pwm_max_voltage = <0x155cc0>;
		rockchip,pwm_suspend_voltage = <0xe7ef0>;
		rockchip,pwm_coefficient = <0x1c2>;
		status = "okay";

		regulators {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			regulator@0 {
				regulator-compatible = "pwm_dcdc1";
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <0xe7ef0>;
				regulator-max-microvolt = <0x155cc0>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};

	pwm-regulator2 {
		compatible = "rockchip_pwm_regulator";
		pwms = <0xb8 0x0 0x1388>;
		rockchip,pwm_id = <0x2>;
		rockchip,pwm_voltage_map = <0xf4240 0xfa3e8 0x100590 0x106738 0x10c8e0 0x112a88 0x118c30 0x11edd8 0x124f80 0x12b128 0x1312d0 0x137478 0x13d620>;
		rockchip,pwm_voltage = <0x124f80>;
		rockchip,pwm_min_voltage = <0xf4240>;
		rockchip,pwm_max_voltage = <0x13d620>;
		rockchip,pwm_suspend_voltage = <0x1312d0>;
		rockchip,pwm_coefficient = <0x12c>;
		status = "okay";

		regulators {
			#address-cells = <0x1>;
			#size-cells = <0x0>;

			regulator@1 {
				regulator-compatible = "pwm_dcdc2";
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <0xf4240>;
				regulator-max-microvolt = <0x13d620>;
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};

	usb_control {
		compatible = "rockchip,rk322x-usb-control";
		rockchip,remote_wakeup;
		rockchip,usb_irq_wakeup;
		host_drv_gpio = <0xb4 0x14 0x1>;
		otg_drv_gpio = <0xb4 0x16 0x1>;
	};

	rockchip_audio {
		compatible = "rockchip,rk322x-audio";

		dais {

			dai0 {
				audio-codec = <0xb9>;
				audio-controller = <0xba>;
				format = "i2s";
			};
		};
	};

	rockchip_spdif_card {
		compatible = "rockchip-spdif-card";

		dais {

			dai0 {
				audio-codec = <0xbb>;
				audio-controller = <0xbc>;
			};
		};
	};

	rockchip_hdmi_i2s {
		compatible = "rockchip-hdmi-i2s";

		dais {

			dai0 {
				audio-codec = <0xbd>;
				audio-controller = <0xbe>;
				format = "i2s";
			};
		};
	};

	rockchip_nau8540 {
		status = "disabled";
		compatible = "rockchip,nau8540-audio";

		dais {

			dai0 {
				audio-codec = <0xbf>;
				audio-controller = <0xba>;
				format = "i2s";
			};
		};
	};

	status-led {
		compatible = "cyx,leds";
		LED,red_gpio = <0xb4 0x15 0x1>;
		LED,blue_gpio = <0x8e 0x7 0x1>;
		gpio_id0 = <0x76 0xe 0x1>;
		gpio_id1 = <0x76 0xd 0x1>;
		gpio_id2 = <0x8e 0x3 0x1>;
		status = "okay";
	};

	shutdown-key {
		compatible = "cyx,shutdown_key";
		shutdown_key_io = <0x76 0x3 0x1>;
		status = "okay";
	};

	cyx-vfd {
		compatible = "cyxtech,vfd";
		dev_name = "cyx-vfd";
		vfd,clock_gpio = <0x8e 0x0 0x1>;
		vfd,stb_gpio = <0x8e 0x1 0x1>;
		vfd,data_gpio = <0x8e 0x2 0x1>;
		status = "okay";
	};
};
