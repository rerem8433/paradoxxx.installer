						phandle = <0x1d>;
					};

					clk_i2s0_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0x8 0x2>;
						clocks = <0x1d 0x1f 0x13 0x14>;
						clock-output-names = "clk_i2s0";
						#clock-cells = <0x0>;
						rockchip,clkops-idx = <0xe>;
						rockchip,flags = <0x4>;
						linux,phandle = <0x49>;
						phandle = <0x49>;
					};

					i2s0_pll_mux {
						compatible = "rockchip,rk3188-mux-con";
						rockchip,bits = <0xf 0x1>;
						clocks = <0xb 0x8>;
						clock-output-names = "clk_i2s0_pll";
