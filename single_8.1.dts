	rockchip-suspend {
		compatible = "rockchip,pm-rk322x";
		status = "okay";
		rockchip,virtual-poweroff = <0x1>;
		rockchip,sleep-mode-config = <0x10042>;
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		interrupts = <0x0 0x51 0x4>;
		rockchip,serial-id = <0x2>;
		rockchip,signal-irq = <0x9f>;
		rockchip,wake-irq = <0x0>;
		rockchip,irq-mode-enable = <0x0>;
		rockchip,baudrate = <0x16e360>;
		pinctrl-names = "default";
		pinctrl-0 = <0x29>;
	};

	firmware {

		android {
			compatible = "android,firmware";

			fstab {
				compatible = "android,fstab";

				system {
					compatible = "android,system";
					dev = "/dev/block/by-name/system";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges;

		drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x0 0x0>;
			phandle = <0x4a>;
		};

		secure-memory@80000000 {
			compatible = "rockchip,secure-memory";
			reg = <0x80000000 0x0>;
			phandle = <0x4b>;
		};

		ramoops@62e00000 {
			reg = <0x62e00000 0xf0000>;
			phandle = <0x66>;
		};
	};

	ramoops {
		compatible = "ramoops";
		record-size = <0x0 0x20000>;
		console-size = <0x0 0x80000>;
		ftrace-size = <0x0 0x0>;
		pmsg-size = <0x0 0x50000>;
		memory-region = <0x66>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	leds {
		compatible = "gpio-leds";

		power-red {
			gpios = <0x3e 0x7 0x0>;
			linux,default-trigger = "none";
			default-state = "on";
		};

		power-green {
			gpios = <0x67 0x15 0x0>;
			linux,default-trigger = "none";
			default-state = "off";
		};
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,name = "rockchip,rk3229";

		simple-audio-card,cpu {
			sound-dai = <0x68>;
		};

		simple-audio-card,codec {
			sound-dai = <0x69>;
		};
	};

	hdmi-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x80>;
		simple-audio-card,name = "rockchip,hdmi";

		simple-audio-card,cpu {
			sound-dai = <0x6a>;
		};

		simple-audio-card,codec {
			sound-dai = <0x6b>;
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		regulator@0 {
			compatible = "regulator-fixed";
			regulator-name = "vccio_1v8";
			regulator-min-microvolt = <0x1b7740>;
			regulator-max-microvolt = <0x1b7740>;
			regulator-always-on;
			phandle = <0x1e>;
		};

		regulator@1 {
			compatible = "regulator-fixed";
			regulator-name = "vccio_3v3";
			regulator-min-microvolt = <0x325aa0>;
			regulator-max-microvolt = <0x325aa0>;
			regulator-always-on;
			phandle = <0x1d>;
		};
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <0x6c>;
		reset-gpios = <0x6d 0x1a 0x1>;
		phandle = <0x5a>;
	};

	spdif-out {
		status = "okay";
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0x0>;
		phandle = <0x6f>;
	};

	spdif-sound {
		status = "okay";
		compatible = "simple-audio-card";
		simple-audio-card,name = "ROCKCHIP,SPDIF";

		simple-audio-card,cpu {
			sound-dai = <0x6e>;
		};

		simple-audio-card,codec {
			sound-dai = <0x6f>;
		};
	};

	vcc-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x67 0x14 0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <0x70>;
		regulator-name = "vcc_host";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x20>;
	};

	otg-vbus-regulator {
		compatible = "regulator-fixed";
		gpio = <0x67 0x16 0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <0x71>;
		regulator-name = "vcc_otg_vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		enable-active-high;
		phandle = <0x1f>;
	};

	vcc-phy-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		regulator-name = "vcc_phy";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x61>;
	};

	vdd-arm-regulator {
		compatible = "pwm-regulator";
		rockchip,pwm_id = <0x1>;
		rockchip,pwm_voltage = <0x10c8e0>;
		pwms = <0x72 0x0 0x1388 0x1>;
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <0xe7ef0>;
		regulator-max-microvolt = <0x155cc0>;
		regulator-settling-time-up-us = <0xfa>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x4>;
	};

	vdd-log-regulator {
		compatible = "pwm-regulator";
		rockchip,pwm_id = <0x2>;
		rockchip,pwm_voltage = <0x124f80>;
		pwms = <0x73 0x0 0x1388 0x1>;
		regulator-name = "vdd_log";
		regulator-min-microvolt = <0xf4240>;
		regulator-max-microvolt = <0x13d620>;
		regulator-settling-time-up-us = <0xfa>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0xc>;
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0x74>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0x67 0x6 0x1>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <0x75>;
		pinctrl-1 = <0x76>;
		BT,power_gpio = <0x6d 0x1d 0x0>;
		BT,wake_host_irq = <0x67 0x1a 0x0>;
		status = "disabled";
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x38>;
		wifi_chip_type = "rtl8189es";
		sdio_vref = <0xce4>;
		WIFI,host_wake_irq = <0x77 0x1c 0x0>;
		status = "okay";
	};
};
