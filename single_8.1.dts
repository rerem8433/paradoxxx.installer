/dts-v1/;

/ {
	#address-cells = <0x1>;
	#size-cells = <0x1>;
	interrupt-parent = <0x1>;
	model = "Rockchip RK3229 Evaluation board";
	compatible = "rockchip,rk3229-evb", "rockchip,rk3229";

	dram_timing {
		compatible = "rockchip,dram-timing";
		dram_spd_bin = <0x15>;
		sr_idle = <0x18>;
		pd_idle = <0x20>;
		dram_dll_disb_freq = <0x12c>;
		phy_dll_disb_freq = <0x190>;
		dram_odt_disb_freq = <0x190>;
		phy_odt_disb_freq = <0x190>;
		ddr3_drv = <0x0>;
		ddr3_odt = <0x40>;
		lpddr3_drv = <0x1>;
		lpddr3_odt = <0x3>;
		lpddr2_drv = <0x1>;
		phy_ddr3_clk_drv = <0x11>;
		phy_ddr3_cmd_drv = <0x11>;
		phy_ddr3_dqs_drv = <0x12>;
		phy_ddr3_odt = <0x2>;
		phy_lp23_clk_drv = <0x13>;
		phy_lp23_cmd_drv = <0x16>;
		phy_lp23_dqs_drv = <0x16>;
		phy_lp3_odt = <0x2>;
		phandle = <0xb>;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0x11030000";
	};

	aliases {
		serial0 = "/serial@11010000";
		serial1 = "/serial@11020000";
		serial2 = "/serial@11030000";
		spi0 = "/spi@11090000";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x0>;
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@f00 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf00>;
			resets = <0x2 0x4>;
			operating-points-v2 = <0x3>;
			#cooling-cells = <0x2>;
			dynamic-power-coefficient = <0x7a>;
			clock-latency = <0x9c40>;
			clocks = <0x2 0x5>;
			enable-method = "psci";
			cpu-supply = <0x4>;
			phandle = <0x6>;
		};

		cpu@f01 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf01>;
			resets = <0x2 0x5>;
			operating-points-v2 = <0x3>;
			enable-method = "psci";
			phandle = <0x7>;
		};

		cpu@f02 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf02>;
			resets = <0x2 0x6>;
			operating-points-v2 = <0x3>;
			enable-method = "psci";
			phandle = <0x8>;
		};

		cpu@f03 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0xf03>;
			resets = <0x2 0x7>;
			operating-points-v2 = <0x3>;
			enable-method = "psci";
			phandle = <0x9>;
		};
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		clocks = <0x2 0x1>;
		rockchip,max-volt = <0x149970>;
		rockchip,leakage-voltage-sel = <0x1 0x4 0x0 0x5 0xfe 0x1>;
		nvmem-cells = <0x5>;
		nvmem-cell-names = "cpu_leakage";
		phandle = <0x3>;

		opp-408000000 {
			opp-hz = <0x0 0x18519600>;
			opp-microvolt = <0x12b128>;
			opp-microvolt-L0 = <0x12b128>;
			opp-microvolt-L1 = <0x12b128>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-600000000 {
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0x1312d0>;
			opp-microvolt-L0 = <0x1312d0>;
			opp-microvolt-L1 = <0x1312d0>;
		};

		opp-816000000 {
			opp-hz = <0x0 0x30a32c00>;
			opp-microvolt = <0x137478>;
			opp-microvolt-L0 = <0x137478>;
			opp-microvolt-L1 = <0x137478>;
		};

		opp-1008000000 {
			opp-hz = <0x0 0x3c14dc00>;
			opp-microvolt = <0x13d620>;
			opp-microvolt-L0 = <0x13d620>;
			opp-microvolt-L1 = <0x13d620>;
		};

		opp-1200000000 {
			opp-hz = <0x0 0x47868c00>;
			opp-microvolt = <0x1437c8>;
			opp-microvolt-L0 = <0x1437c8>;
			opp-microvolt-L1 = <0x1437c8>;
		};

		opp-1296000000 {
			opp-hz = <0x0 0x4d3f6400>;
			opp-microvolt = <0x1437c8>;
			opp-microvolt-L0 = <0x1437c8>;
			opp-microvolt-L1 = <0x1437c8>;
		};

		opp-1392000000 {
			opp-hz = <0x0 0x52f83c00>;
			opp-microvolt = <0x149970>;
			opp-microvolt-L0 = <0x149970>;
			opp-microvolt-L1 = <0x149970>;
		};

		opp-1464000000 {
			opp-hz = <0x0 0x5742de00>;
			opp-microvolt = <0x149970>;
			opp-microvolt-L0 = <0x149970>;
			opp-microvolt-L1 = <0x149970>;
		};
	};

	amba {
		compatible = "arm,amba-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges;

		pdma@110f0000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0x110f0000 0x4000>;
			interrupts = <0x0 0x0 0x4 0x0 0x1 0x4>;
			#dma-cells = <0x1>;
			clocks = <0x2 0xc2>;
			clock-names = "apb_pclk";
			peripherals-req-type-burst;
			phandle = <0xe>;
		};
	};

	arm-pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x0 0x4c 0x4 0x0 0x4d 0x4 0x0 0x4e 0x4 0x0 0x4f 0x4>;
		interrupt-affinity = <0x6 0x7 0x8 0x9>;
	};

	dmc {
		compatible = "rockchip,rk3228-dmc", "rockchip,rk322x-dram";
		clocks = <0x2 0x90>;
		clock-names = "dmc_clk";
		operating-points-v2 = <0xa>;
		system-status-freq = <0x1 0xc3500 0x10 0xc3500 0x10000 0xc3500>;
		dram_freq = <0x2faf0800>;
		rockchip,dram_timing = <0xb>;
		#cooling-cells = <0x2>;
		status = "okay";
		center-supply = <0xc>;

		ddr_power_model {
			compatible = "ddr_power_model";
			dynamic-power-coefficient = <0x78>;
			static-power-coefficient = <0xc8>;
			ts = <0x7d00 0x125c 0xffffffb0 0x2>;
			thermal-zone = "soc-thermal";
		};
	};

	dmc-opp-table {
		compatible = "operating-points-v2";
		rockchip,leakage-voltage-sel = <0x1 0x5 0x0 0x6 0xfe 0x1>;
		nvmem-cells = <0xd>;
		nvmem-cell-names = "ddr_leakage";
		phandle = <0xa>;

		opp-300000000 {
			opp-hz = <0x0 0x11e1a300>;
			opp-microvolt = <0x100590>;
			opp-microvolt-L0 = <0x100590>;
			opp-microvolt-L1 = <0xf4240>;
		};

		opp-400000000 {
			opp-hz = <0x0 0x17d78400>;
			opp-microvolt = <0x100590>;
			opp-microvolt-L0 = <0x100590>;
			opp-microvolt-L1 = <0xf4240>;
		};

		opp-600000000 {
			opp-hz = <0x0 0x23c34600>;
			opp-microvolt = <0x10c8e0>;
			opp-microvolt-L0 = <0x10c8e0>;
			opp-microvolt-L1 = <0x100590>;
		};

		opp-666000000 {
			opp-hz = <0x0 0x27b25a80>;
			opp-microvolt = <0x118c30>;
			opp-microvolt-L0 = <0x118c30>;
			opp-microvolt-L1 = <0x10c8e0>;
		};

		opp-700000000 {
			opp-hz = <0x0 0x29b92700>;
			opp-microvolt = <0x118c30>;
			opp-microvolt-L0 = <0x118c30>;
			opp-microvolt-L1 = <0x10c8e0>;
		};

		opp-786000000 {
			opp-hz = <0x0 0x2ed96880>;
			opp-microvolt = <0x118c30>;
			opp-microvolt-L0 = <0x118c30>;
			opp-microvolt-L1 = <0x10c8e0>;
		};

		opp-800000000 {
			opp-hz = <0x0 0x2faf0800>;
			opp-microvolt = <0x118c30>;
			opp-microvolt-L0 = <0x118c30>;
			opp-microvolt-L1 = <0x10c8e0>;
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x1 0xd 0xf04 0x1 0xe 0xf04 0x1 0xb 0xf04 0x1 0xa 0xf04>;
		clock-frequency = <0x16e3600>;
	};

	oscillator {
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		#clock-cells = <0x0>;
		phandle = <0x37>;
	};

	i2s1@100b0000 {
		compatible = "rockchip,rk3228-i2s", "rockchip,rk3066-i2s";
		reg = <0x100b0000 0x4000>;
		interrupts = <0x0 0x1b 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2s_clk", "i2s_hclk";
		clocks = <0x2 0x51 0x2 0x1bb>;
		dmas = <0xe 0xe 0xe 0xf>;
		dma-names = "tx", "rx";
		pinctrl-names = "default";
		pinctrl-0 = <0xf>;
		status = "okay";
		#sound-dai-cells = <0x0>;
		phandle = <0x68>;
	};

	i2s0@100c0000 {
		compatible = "rockchip,rk3228-i2s", "rockchip,rk3066-i2s";
		reg = <0x100c0000 0x4000>;
		interrupts = <0x0 0x1a 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2s_clk", "i2s_hclk";
		clocks = <0x2 0x50 0x2 0x1ba>;
		dmas = <0xe 0xb 0xe 0xc>;
		dma-names = "tx", "rx";
		status = "okay";
		rockchip,bclk-fs = <0x80>;
		#sound-dai-cells = <0x0>;
		phandle = <0x6a>;
	};

	spdif@100d0000 {
		compatible = "rockchip,rk3228-spdif";
		reg = <0x100d0000 0x1000>;
		interrupts = <0x0 0x1d 0x4>;
		clocks = <0x2 0x53 0x2 0x1bd>;
		clock-names = "mclk", "hclk";
		dmas = <0xe 0xa>;
		#dma-cells = <0x1>;
		dma-names = "tx";
		pinctrl-names = "default";
		pinctrl-0 = <0x10>;
		status = "okay";
		#sound-dai-cells = <0x0>;
		phandle = <0x6e>;
	};

	i2s2@100e0000 {
		compatible = "rockchip,rk3228-i2s", "rockchip,rk3066-i2s";
		reg = <0x100e0000 0x4000>;
		interrupts = <0x0 0x1c 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2s_clk", "i2s_hclk";
		clocks = <0x2 0x52 0x2 0x1bc>;
		dmas = <0xe 0x0 0xe 0x1>;
		dma-names = "tx", "rx";
		status = "disabled";
	};

	tsp@100f0000 {
		compatible = "rockchip,rk3228-tsp";
		reg = <0x100f0000 0x10000>;
		interrupts = <0x0 0x48 0x4>;
		interrupt-names = "irq_tsp";
		clocks = <0x2 0x8b 0x2 0x1db 0x2 0x8c>;
		clock-names = "clk_tsp", "hclk_tsp", "aclk_tsp";
		pinctrl-names = "default";
		pinctrl-0 = <0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c>;
		status = "disabled";
	};

	syscon@11000000 {
		compatible = "rockchip,rk3228-grf", "syscon", "simple-mfd";
		reg = <0x11000000 0x1000>;
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		phandle = <0x38>;

		io-domains {
			compatible = "rockchip,rk322x-io-voltage-domain";
			status = "okay";
			vccio1-supply = <0x1d>;
			vccio2-supply = <0x1e>;
			vccio4-supply = <0x1d>;
		};

		reboot-mode {
			compatible = "syscon-reboot-mode";
			offset = <0x5c8>;
			mode-normal = <0x5242c300>;
			mode-recovery = <0x5242c303>;
			mode-bootloader = <0x5242c309>;
			mode-loader = <0x5242c301>;
			mode-ums = <0x5242c30c>;
		};

		usb2-phy@760 {
			compatible = "rockchip,rk322x-usb2phy";
			reg = <0x760 0xc>;
			clocks = <0x2 0x8e>;
			clock-names = "phyclk";
			#clock-cells = <0x0>;
			clock-output-names = "usb480m_phy0";
			status = "okay";
			phandle = <0x5c>;

			otg-port {
				#phy-cells = <0x0>;
				interrupts = <0x0 0x3b 0x4 0x0 0x3c 0x4 0x0 0x3d 0x4>;
				interrupt-names = "otg-bvalid", "otg-id", "linestate";
				status = "okay";
				vbus-supply = <0x1f>;
				phandle = <0x5b>;
			};

			host-port {
				#phy-cells = <0x0>;
				interrupts = <0x0 0x3e 0x4>;
				interrupt-names = "linestate";
				status = "okay";
				phy-supply = <0x20>;
				phandle = <0x5d>;
			};
		};

		usb2-phy@800 {
			compatible = "rockchip,rk322x-usb2phy";
			reg = <0x800 0xc>;
			clocks = <0x2 0x8f>;
			clock-names = "phyclk";
			#clock-cells = <0x0>;
			clock-output-names = "usb480m_phy1";
			status = "okay";
			phandle = <0x5e>;

			otg-port {
				#phy-cells = <0x0>;
				interrupts = <0x0 0x45 0x4>;
				interrupt-names = "linestate";
				status = "okay";
				phandle = <0x60>;
			};

			host-port {
				#phy-cells = <0x0>;
				interrupts = <0x0 0x44 0x4>;
				interrupt-names = "linestate";
				status = "okay";
				phy-supply = <0x20>;
				phandle = <0x5f>;
			};
		};

		power-controller {
			compatible = "rockchip,rk3228-power-controller";
			#power-domain-cells = <0x1>;
			#address-cells = <0x1>;
			#size-cells = <0x0>;
			status = "okay";
			phandle = <0x41>;

			pd_vpu@6 {
				reg = <0x6>;
				clocks = <0x2 0xca 0x2 0x1d0>;
				pm_qos = <0x21>;
			};

			pd_rkvdec@7 {
				reg = <0x7>;
				clocks = <0x2 0xcb 0x2 0x1d1 0x2 0x85 0x2 0x86>;
				pm_qos = <0x22 0x23>;
			};
		};
	};

	serial@11010000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x11010000 0x100>;
		interrupts = <0x0 0x37 0x4>;
		clock-frequency = <0x16e3600>;
		clocks = <0x2 0x4d 0x2 0x155>;
		clock-names = "baudclk", "apb_pclk";
		pinctrl-names = "default";
		pinctrl-0 = <0x24 0x25 0x26>;
		reg-shift = <0x2>;
		reg-io-width = <0x4>;
		status = "disabled";
	};

	serial@11020000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x11020000 0x100>;
		interrupts = <0x0 0x38 0x4>;
		clock-frequency = <0x16e3600>;
		clocks = <0x2 0x4e 0x2 0x156>;
		clock-names = "baudclk", "apb_pclk";
		pinctrl-names = "default";
		pinctrl-0 = <0x27 0x28>;
		reg-shift = <0x2>;
		reg-io-width = <0x4>;
		status = "okay";
	};

	serial@11030000 {
		compatible = "snps,dw-apb-uart";
		reg = <0x11030000 0x100>;
		interrupts = <0x0 0x39 0x4>;
		clock-frequency = <0x16e3600>;
		clocks = <0x2 0x4f 0x2 0x157>;
		clock-names = "baudclk", "apb_pclk";
		pinctrl-names = "default";
		pinctrl-0 = <0x29>;
		reg-shift = <0x2>;
		reg-io-width = <0x4>;
		status = "disabled";
	};

	efuse@11040000 {
		compatible = "rockchip,rk322x-efuse";
		reg = <0x11040000 0x20>;
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		clocks = <0x2 0x147>;
		clock-names = "pclk_efuse";

		id@7 {
			reg = <0x7 0x10>;
		};

		cpu_leakage@17 {
			reg = <0x17 0x1>;
			phandle = <0x5>;
		};

		logic-leakage@19 {
			reg = <0x19 0x1>;
			phandle = <0xd>;
		};

		hdmi_phy_flag@1d {
			reg = <0x1d 0x1>;
			bits = <0x1 0x1>;
			phandle = <0x3f>;
		};

		tve_dac@1d {
			reg = <0x1d 0x1>;
			bits = <0x3 0x5>;
			phandle = <0x52>;
		};
	};

	i2c@11050000 {
		compatible = "rockchip,rk3228-i2c";
		reg = <0x11050000 0x1000>;
		interrupts = <0x0 0x24 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2c";
		clocks = <0x2 0x14c>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2a>;
		status = "okay";

		hym8563@51 {
			compatible = "haoyu,hym8563";
			reg = <0x51>;
			#clock-cells = <0x0>;
			clock-frequency = <0x8000>;
			clock-output-names = "xin32k";
			phandle = <0x74>;
		};
	};

	i2c@11060000 {
		compatible = "rockchip,rk3228-i2c";
		reg = <0x11060000 0x1000>;
		interrupts = <0x0 0x25 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2c";
		clocks = <0x2 0x14d>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2b>;
		status = "disabled";
	};

	i2c@11070000 {
		compatible = "rockchip,rk3228-i2c";
		reg = <0x11070000 0x1000>;
		interrupts = <0x0 0x26 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2c";
		clocks = <0x2 0x14e>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2c>;
		status = "disabled";
	};

	i2c@11080000 {
		compatible = "rockchip,rk3228-i2c";
		reg = <0x11080000 0x1000>;
		interrupts = <0x0 0x27 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		clock-names = "i2c";
		clocks = <0x2 0x14f>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2d>;
		status = "disabled";
	};

	spi@11090000 {
		compatible = "rockchip,rk3228-spi";
		reg = <0x11090000 0x1000>;
		interrupts = <0x0 0x31 0x4>;
		#address-cells = <0x1>;
		#size-cells = <0x0>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2e 0x2f 0x30 0x31 0x32>;
		clocks = <0x2 0x41 0x2 0x152>;
		clock-names = "spiclk", "apb_pclk";
		status = "disabled";
	};

	watchdog@110a0000 {
		compatible = "rockchip,rk322x-wdt", "snps,dw-wdt";
		reg = <0x110a0000 0x100>;
		clocks = <0x2 0x162>;
		interrupts = <0x0 0x28 0x4>;
		status = "disabled";
	};

	pwm@110b0000 {
		compatible = "rockchip,rk3288-pwm";
		reg = <0x110b0000 0x10>;
		#pwm-cells = <0x3>;
		clocks = <0x2 0x15e>;
		clock-names = "pwm";
		pinctrl-names = "active";
		pinctrl-0 = <0x33>;
		status = "disabled";
	};

	pwm@110b0010 {
		compatible = "rockchip,rk3288-pwm";
		reg = <0x110b0010 0x10>;
		#pwm-cells = <0x3>;
		clocks = <0x2 0x15e>;
		clock-names = "pwm";
		pinctrl-names = "active";
		pinctrl-0 = <0x34>;
		status = "okay";
		phandle = <0x72>;
	};

	pwm@110b0020 {
		compatible = "rockchip,rk3288-pwm";
		reg = <0x110b0020 0x10>;
		#pwm-cells = <0x3>;
		clocks = <0x2 0x15e>;
		clock-names = "pwm";
